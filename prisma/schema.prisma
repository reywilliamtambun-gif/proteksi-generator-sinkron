generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizResult {
  id            String   @id @default(cuid())
  score         Int
  totalQuestions Int
  percentage    Int
  category      String
  answers       String   // JSON string of answers
  createdAt     DateTime @default(now())
}

model SimulationLog {
  id            String   @id @default(cuid())
  faultType     String
  relayActivated String
  cbStatus      String
  eventLog      String   // JSON string of event log entries
  duration      Int      // simulation duration in ms
  createdAt     DateTime @default(now())
}
